{
	"name": "svelte-persistent-runes",
	"version": "2.2.0",
	"description": "A Svelte reactive rune that keep its value through pages and reloads",
	"license": "MIT",
	"author": "andrescera",
	"homepage": "https://github.com/andrescera/svelte-persistent-runes",
	"repository": {
		"type": "git",
		"url": "https://github.com/andrescera/svelte-persistent-runes"
	},
	"bugs": "https://github.com/andrescera/svelte-persistent-runes/issues",
	"type": "module",
	"sideEffects": false,
	"packageManager": "bun@1.4.2",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.js"
		},
		"./preprocessor": {
			"types": "./dist/preprocessor.d.ts",
			"import": "./dist/preprocessor.mjs",
			"default": "./dist/preprocessor.js"
		},
		"./plugins": {
			"types": "./dist/plugins.d.ts",
			"import": "./dist/plugins.mjs",
			"default": "./dist/plugins.js"
		},
		"./options": {
			"types": "./dist/options.d.ts",
			"import": "./dist/options.mjs",
			"default": "./dist/options.js"
		}
	},
	"main": "dist/index.js",
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "pkgroll --clean-dist",
		"fix": "biome check --write .",
		"lint": "biome check .",
		"prepublishOnly": "bun run build",
		"typecheck": "tsc --noEmit",
		"test": "ava && ava --config ava.runtime.config.mjs",
		"test:unit": "ava",
		"test:runtime": "ava --config ava.runtime.config.mjs",
		"test:watch": "ava --watch",
		"test:types": "tsc -p test-d/tsconfig.json && tsc -p test-d/tsconfig.legacy.json && tsc -p test-d/tsconfig.legacy-v210.json && svelte-check --workspace test-d/svelte --tsconfig tsconfig.json --fail-on-warnings",
		"lint:package": "publint run --level error && attw --pack . --profile esm-only",
		"check:dist": "node scripts/check-dist.mjs"
	},
	"types": "dist/index.d.ts",
	"dependencies": {
		"@macfja/serializer": "^1.1.4",
		"@sveltejs/acorn-typescript": "^1.0.13",
		"acorn": "^8.18.0",
		"browser-cookies": "^1.2.0",
		"devalue": "^5.9.4",
		"esserializer": "^1.3.11",
		"magic-string": "^1.4.2",
		"next-json": "^0.5.1",
		"php-serialize": "^5.1.3",
		"serialize-anything": "^1.2.3",
		"sjcl-codec-hex": "^1.0.0",
		"sjcl-es": "^2.0.0",
		"superjson": "^2.2.6",
		"zimmerframe": "^1.1.5"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"vite": "^6 || ^7 || ^8"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.5.14",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/estree": "^1.0.9",
		"@types/node": "^24",
		"ava": "^8.0.1",
		"pkgroll": "^2.28.1",
		"publint": "^0.3.24",
		"rollup": "^4.63.4",
		"svelte-check": "^4.7.6",
		"svelte-persistent-runes-v210": "npm:svelte-persistent-runes@2.1.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9",
		"vite": "^8.3.0"
	},
	"keywords": [
		"cookie",
		"encryptedStorage",
		"localStorage",
		"persist",
		"persistent",
		"rune",
		"runes",
		"sessionStorage",
		"svelte",
		"sveltejs",
		"sveltekit"
	]
}
